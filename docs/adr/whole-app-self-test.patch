+static PICKS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[tauri::command]
+fn spike_mode() -> String {
+    std::env::var("SPIKE_MODE").unwrap_or_default()
+}
+#[tauri::command]
+fn spike_pick<R: Runtime>(
+    app: tauri::AppHandle<R>,
+) -> error::IpcResult<Option<synapse_core::domain::Document>> {
+    let names: Vec<String> = std::env::var("SPIKE_FILES")
+        .unwrap()
+        .split(':')
+        .map(str::to_owned)
+        .collect();
+    let index = PICKS.fetch_add(1, std::sync::atomic::Ordering::SeqCst) % names.len();
+    access::register_and_grant(&app, std::path::Path::new(&names[index])).map(Some)
+}
+#[tauri::command]
+fn spike_drop<R: Runtime>(app: tauri::AppHandle<R>) {
+    let names: Vec<String> = std::env::var("SPIKE_FILES")
+        .unwrap()
+        .split(':')
+        .map(str::to_owned)
+        .collect();
+    let index = PICKS.fetch_add(1, std::sync::atomic::Ordering::SeqCst) % names.len();
+    let paths = vec![std::path::PathBuf::from(&names[index])];
+    let payload = access::register_dropped_paths(&app, &paths);
+    let _ = tauri::Emitter::emit(&app, access::DOCUMENTS_DROPPED_EVENT, &payload);
+}
+#[tauri::command]
+fn spike_progress(step: String) {
+    println!("STEP {step}");
+}
+#[tauri::command]
+fn spike_report(report: String) {
+    println!("SPIKE_REPORT_BEGIN\n{report}\nSPIKE_REPORT_END");
+    std::process::exit(0);
+}
