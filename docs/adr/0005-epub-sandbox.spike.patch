diff --git a/apps/desktop/spike/epub-main.js b/apps/desktop/spike/epub-main.js
new file mode 100644
index 0000000..99552a5
--- /dev/null
+++ b/apps/desktop/spike/epub-main.js
@@ -0,0 +1,65 @@
+import { convertFileSrc, invoke } from '@tauri-apps/api/core';
+import ePub from 'epubjs';
+const violations = [];
+const watch = (doc, where) => doc.addEventListener('securitypolicyviolation', (e) => violations.push(`${where}: ${e.effectiveDirective} ${(e.blockedURI||'').slice(0,40)}`));
+watch(document, 'parent');
+const r = { ua: navigator.userAgent };
+const sleep = (ms) => new Promise((d) => setTimeout(d, ms));
+const timeout = (p, ms, label) => Promise.race([p, new Promise((d) => setTimeout(() => d(`TIMEOUT ${label}`), ms))]);
+const attempt = async (name, fn) => { try { r[name] = await fn(); } catch (e) { r[name] = 'ERROR: ' + (e?.message ?? e); } };
+(async () => {
+  const cfg = await invoke('spike_config');
+  r.scripted = cfg.scripted;
+  const bytes = await (await fetch(convertFileSrc(cfg.allowedPdf))).arrayBuffer();
+  r.bytes = bytes.byteLength;
+  const book = ePub(bytes);
+  const rendition = book.renderTo(document.getElementById('book'), { flow: 'scrolled-doc', width: '100%', height: 600, allowScriptedContent: cfg.scripted });
+  const relocated = [];
+  rendition.on('relocated', (l) => relocated.push(l.start.cfi));
+  await attempt('display', () => timeout(rendition.display().then(() => 'ok'), 15000, 'display'));
+  await sleep(800);
+  const contents = rendition.getContents()[0];
+  const doc = contents.document;
+  watch(doc, 'iframe');
+  const iframe = document.querySelector('iframe');
+  r.iframe = { sandbox: iframe.getAttribute('sandbox'), hasSrcdoc: iframe.hasAttribute('srcdoc'), src: (iframe.getAttribute('src')||'').slice(0,20) };
+  r.scriptTags = doc.querySelectorAll('script').length;
+  r.handlerAttrs = doc.querySelectorAll('[onerror]').length;
+  r.srcdocHasScript = (iframe.getAttribute('srcdoc')||'').includes('data-book-script-ran');
+  r.srcdocSample = (iframe.getAttribute('srcdoc')||'').slice(0,160);
+  { const probe = doc.createElement('script'); probe.textContent = "document.documentElement.setAttribute('data-injected-ran','1')"; doc.head.append(probe); await sleep(100); r.injectedInlineRan = doc.documentElement.getAttribute('data-injected-ran');
+    const probe2 = doc.createElement('img'); probe2.setAttribute('onerror',"document.documentElement.setAttribute('data-injected-handler','1')"); probe2.src='nope.png'; doc.body.append(probe2); await sleep(200); r.injectedHandlerRan = doc.documentElement.getAttribute('data-injected-handler'); }
+  r.bookScriptRan = doc.documentElement.getAttribute('data-book-script-ran');
+  r.bookHandlerRan = doc.documentElement.getAttribute('data-book-handler-ran');
+  r.parentFlag = window.__bookScriptRan ?? null;
+  r.title = doc.querySelector('h1')?.textContent;
+  r.h1Color = getComputedStyle(doc.querySelector('h1')).color;
+  const img = doc.querySelector('img[alt="a small box"]');
+  r.image = { src: (img?.getAttribute('src')||'').slice(0,12), natural: img?.naturalWidth };
+
+  let listenerFired = 0;
+  doc.addEventListener('selectionchange', () => { listenerFired += 1; });
+  const selectedP = new Promise((d) => rendition.on('selected', (cfi) => d(cfi)));
+  const p = [...doc.querySelectorAll('p')].find((e) => e.textContent.includes('quick brown fox'));
+  const text = p.firstChild;
+  doc.defaultView.getSelection().setBaseAndExtent(text, 4, text, 19);
+  await sleep(600);
+  r.selectionText = doc.defaultView.getSelection().toString();
+  r.parentListenerFired = listenerFired;
+  r.selectedEvent = await timeout(selectedP, 2500, 'selected event');
+
+  await attempt('cfiFromRangeDirect', async () => contents.cfiFromRange(doc.defaultView.getSelection().getRangeAt(0)));
+  const cfi = r.cfiFromRangeDirect;
+  await attempt('highlight', async () => {
+    rendition.annotations.highlight(cfi, {}, () => {}, 'spike-hl', { fill: 'yellow' });
+    await sleep(300);
+    return { svgMarks: document.querySelectorAll('.spike-hl, svg g').length };
+  });
+  await attempt('rangeFromCfi', async () => (await book.getRange(cfi)).toString());
+  await attempt('jumpChapter2', async () => { await rendition.display('chapter2.xhtml'); await sleep(500); return rendition.getContents()[0].document.querySelector('h1').textContent; });
+  await attempt('jumpBack', async () => { await rendition.display(cfi); await sleep(500); return rendition.getContents()[0].document.querySelector('h1').textContent; });
+  r.relocated = relocated.slice(-3);
+  r.currentLocation = rendition.currentLocation()?.start?.cfi ?? null;
+  r.violations = [...new Set(violations)];
+  await invoke('spike_report', { report: JSON.stringify(r, null, 1) });
+})().catch((e) => invoke('spike_report', { report: 'FATAL ' + (e?.stack || e) }));
