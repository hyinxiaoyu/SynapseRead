diff --git a/apps/desktop/spike/main.js b/apps/desktop/spike/main.js
new file mode 100644
index 0000000..2237751
--- /dev/null
+++ b/apps/desktop/spike/main.js
@@ -0,0 +1,66 @@
+import { convertFileSrc, invoke } from '@tauri-apps/api/core';
+import * as pdfjs from 'pdfjs-dist/legacy/build/pdf.mjs';
+import workerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';
+
+const violations = [];
+document.addEventListener('securitypolicyviolation', (e) => violations.push({ directive: e.effectiveDirective, blocked: e.blockedURI, source: e.sourceFile }));
+const logs = [];
+for (const k of ['warn','error']) { const o = console[k]; console[k] = (...a) => { logs.push(a.join(' ').slice(0,300)); o(...a); }; }
+const r = { location: location.href, userAgent: navigator.userAgent };
+const attempt = async (name, fn) => { try { r[name] = await fn(); } catch (e) { r[name] = 'ERROR: ' + (e?.message ?? e); } };
+const timeout = (p, ms, label) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error('timeout '+label)), ms))]);
+
+(async () => {
+  const cfg = await invoke('spike_config');
+  r.cfg = cfg;
+  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;
+  r.workerUrl = workerUrl;
+
+  await attempt('rawModuleWorker', () => timeout(new Promise((res, rej) => {
+    const w = new Worker(workerUrl, { type: 'module' });
+    w.onerror = (e) => rej(new Error('worker error: ' + (e.message || 'blocked')));
+    w.onmessage = (m) => { res('loaded, first message: ' + JSON.stringify(m.data).slice(0,60)); w.terminate(); };
+  }), 6000, 'rawModuleWorker'));
+
+  await attempt('wasmInWorker', () => timeout(new Promise((res, rej) => {
+    const w = new Worker(new URL('./wasm-worker.js', import.meta.url), { type: 'module' });
+    w.onerror = (e) => rej(new Error(e.message || 'blocked'));
+    w.onmessage = (m) => { res(m.data); w.terminate(); };
+  }), 6000, 'wasmInWorker'));
+
+  const worker = new pdfjs.PDFWorker({ name: 'spike' });
+  await attempt('pdfWorkerReady', () => timeout(worker.promise.then(() => 'ready'), 15000, 'pdfWorker'));
+  r.pdfWorkerIsRealWorker = typeof Worker !== 'undefined' && worker.port instanceof Worker;
+
+  const url = convertFileSrc(cfg.allowedPdf);
+  r.assetUrl = url;
+  await attempt('fetchAllowed', async () => { const x = await fetch(url); const b = await x.arrayBuffer(); return { status: x.status, bytes: b.byteLength, acceptRanges: x.headers.get('accept-ranges'), contentLength: x.headers.get('content-length') }; });
+  await attempt('fetchRange', async () => { const x = await fetch(url, { headers: { Range: 'bytes=0-9' } }); const b = await x.arrayBuffer(); return { status: x.status, bytes: b.byteLength, acceptRanges: x.headers.get('accept-ranges'), contentRange: x.headers.get('content-range') }; });
+  await attempt('fetchUnlisted', async () => { const x = await fetch(convertFileSrc(cfg.unlistedFile)); return { status: x.status, bytes: (await x.arrayBuffer()).byteLength }; });
+
+  const base = './pdfjs/';
+  await attempt('render', async () => {
+    const task = pdfjs.getDocument({ url, worker, isEvalSupported: false, disableFontFace: false,
+      cMapUrl: new URL(base+'cmaps/', location.href).href, cMapPacked: true,
+      standardFontDataUrl: new URL(base+'standard_fonts/', location.href).href,
+      wasmUrl: new URL(base+'wasm/', location.href).href });
+    const doc = await timeout(task.promise, 20000, 'getDocument');
+    const page = await doc.getPage(1);
+    const viewport = page.getViewport({ scale: 1.5 });
+    const canvas = document.getElementById('c');
+    canvas.width = Math.floor(viewport.width); canvas.height = Math.floor(viewport.height);
+    await timeout(page.render({ canvas, viewport }).promise, 20000, 'render');
+    const data = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data;
+    let dark = 0; for (let i = 0; i < data.length; i += 4) if (data[i] < 128 && data[i+3] > 0) dark++;
+    const content = await page.getTextContent();
+    const tl = new pdfjs.TextLayer({ textContentSource: content, container: document.getElementById('t'), viewport });
+    await tl.render();
+    return { numPages: doc.numPages, canvas: [canvas.width, canvas.height], darkPixels: dark,
+      text: content.items.map((i) => i.str).join(' ').slice(0, 90), textLayerSpans: document.querySelectorAll('#t span').length,
+      fontsLoaded: document.fonts.size };
+  });
+  await attempt('standardFontFetch', async () => { const x = await fetch(base + 'standard_fonts/LiberationSans-Regular.ttf'); return { status: x.status, bytes: (await x.arrayBuffer()).byteLength }; });
+
+  r.violations = violations; r.consoleWarnings = logs;
+  await invoke('spike_report', { report: JSON.stringify(r, null, 1) });
+})().catch((e) => invoke('spike_report', { report: 'FATAL ' + e }));
